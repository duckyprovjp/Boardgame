# Server
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Supabase Postgres (Prisma)
# Transaction pooler (port 6543) for runtime app queries
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432, IPv4-compatible) ONLY for `prisma migrate deploy`
DIRECT_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Optional Redis (Phase 8+ only, from Upstash)
# REDIS_URL="rediss://default:PASSWORD@HOST:6379"

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
